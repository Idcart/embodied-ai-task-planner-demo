AI_PROVIDER=zhipu
NODE_ENV=development
PORT=3001

# 前端请求后端 API 的基础地址
# 本地开发推荐保持 /api，由 Vite proxy 转发到后端
VITE_API_BASE_URL=/api
VITE_DEV_API_TARGET=http://localhost:3001

# 生产部署时按实际域名配置
# VITE_API_BASE_URL=https://your-domain.com/api
# CLIENT_ORIGIN=https://your-domain.com
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 上传图片大小限制，单位 MB
UPLOAD_MAX_FILE_SIZE_MB=10

# OpenAI 配置（二选一）
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# 智谱 GLM 配置（二选一）
ZHIPUAI_API_KEY=
ZHIPUAI_MODEL=glm-4.6v
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 小米 MiMo 配置（二选一）
# AI_PROVIDER=mimo
XIAOMI_API_KEY=
XIAOMI_MIMO_TOKEN=
XIAOMI_MIMO_MODEL=mimo-v2-omni
XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 复杂/大尺寸图片建议保持默认压缩参数
VISION_IMAGE_MAX_SIZE=1024
VISION_IMAGE_QUALITY=75
